# Options for the mysql and mysqldump clients of the image (MariaDB).
# Laravel uses the mysql client one time, to load
# database/schema/mysql-schema.sql into a new, empty database.
#
# The MariaDB client checks the TLS certificate of the server by default.
# The MySQL 8.4 server of docker-compose.yml makes a self-signed certificate,
# so the check fails with "ERROR 2026 (HY000): TLS/SSL error: self-signed
# certificate". The connection still uses TLS. Only these two clients read
# this file. PDO, which the app uses for each query, does not read it.
# deploy/README.md tells why the check is off.
[mysql]
ssl-verify-server-cert = 0

[mysqldump]
ssl-verify-server-cert = 0
