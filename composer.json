{
    "name": "feedbackpilgrim/feedbackpilgrim",
    "type": "project",
    "description": "A self-hosted feedback board with votes, a roadmap, release notes, testimonials, a REST API and an MCP server.",
    "keywords": [
        "feedback",
        "feature-requests",
        "roadmap",
        "release-notes",
        "self-hosted",
        "laravel"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.398",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/breeze": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^1.2.1",
        "laravel/sanctum": "^4.4",
        "laravel/tinker": "^3.0",
        "lasserafn/php-initial-avatar-generator": "^4.3",
        "rollbar/rollbar-laravel": "^8.1",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-markdown": "^2.5",
        "spatie/laravel-medialibrary": "^11.23",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "api-docs": [
            "Composer\\Config::disableProcessTimeout",
            "node scripts/api-docs.mjs"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.29"
        },
        "audit": {
            "block-insecure": true
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
