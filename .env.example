# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# All values in this file are optional for the Docker image. With no .env, the
# image runs on http://localhost:8080 with SQLite in the /data volume.
APP_NAME="Feedback Pilgrim"
APP_ENV=production
APP_DEBUG=false

# The Docker image makes a key on the first boot and keeps it in
# /data/.secrets/app_key. Without Docker, generate the key with:
#   php artisan key:generate
# A value here wins over the file.
APP_KEY=

# The dashboard runs on APP_DOMAIN. Each project gets a public site on a
# subdomain of APP_DOMAIN, for example acme.feedback.example.com.
# Point two DNS records at the server:
#   feedback.example.com     A or CNAME
#   *.feedback.example.com   A or CNAME (wildcard)
# For production, APP_DOMAIN is the only required value. Then APP_URL is
# https://APP_DOMAIN. Set APP_URL only when the dashboard is on another host
# or port, for example https://app.example.com with APP_DOMAIN=example.com.
# With no APP_DOMAIN and no APP_URL, the app uses http://localhost:8080.
# APP_DOMAIN=feedback.example.com
# APP_URL=https://feedback.example.com

# When APP_DOMAIN is set, Caddy in the Docker image gets the TLS certificates
# and serves ports 80 and 443. Set CADDY_ENABLED=false when your own proxy
# does TLS. ACME_EMAIL is optional. Let's Encrypt sends expiry notices to it.
# CADDY_ENABLED=auto
# ACME_EMAIL=

# The app reads the visitor IP and the scheme from the X-Forwarded-* headers
# only when the request comes from a trusted proxy. The rate limits and the
# logs use that IP. If TRUSTED_PROXIES is empty, the app trusts the Cloudflare
# ranges in config/trustedproxy.php. The app always trusts 127.0.0.1 and ::1
# (for example Caddy in the Docker image). If you do not use Cloudflare, set a
# comma-separated list of the IP addresses or CIDR ranges of your own proxy.
# Use the address that the app sees, not the public address of the proxy.
# For Caddy or NGINX on the Docker host, that is the Docker network range,
# for example 172.16.0.0/12. Do not use "*" when the app port is open to the
# internet, because a client can then set its own IP.
TRUSTED_PROXIES=

# The default registration mode: true is open, false is closed.
# The owner can change the mode in Admin > Settings. The stored mode wins.
# A new instance shows the setup URL in the log, or run: php artisan fp:setup-url
REGISTRATION_ENABLED=false

# ------------------------------------------------------------------------------
# Sessions and stateful API calls
# ------------------------------------------------------------------------------
# The app derives these values from APP_URL and APP_DOMAIN. Set a value only
# to change the derived value.
# SESSION_DOMAIN: ".APP_DOMAIN", or no domain for localhost and IP addresses.
#   The leading dot shares the dashboard session with the project subdomains.
# SESSION_SECURE_COOKIE: true when APP_URL uses https.
# SANCTUM_STATEFUL_DOMAINS: the app host, APP_DOMAIN and *.APP_DOMAIN.
# SESSION_DOMAIN=.feedback.example.com
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=feedback.example.com,*.feedback.example.com
SESSION_LIFETIME=120

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
# A comma-separated list of channels. Add "rollbar" and set ROLLBAR_TOKEN to
# send errors to Rollbar. The Docker image uses "stderr" (the container log).
# Without Docker, the default is "daily" (files in storage/logs).
# LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
ROLLBAR_TOKEN=

# ------------------------------------------------------------------------------
# Database, cache, sessions and queue (SQLite by default)
# ------------------------------------------------------------------------------
# SQLite needs no server. The Docker image keeps the file in
# /data/database.sqlite. Without Docker, the default file is
# database/database.sqlite.
DB_CONNECTION=sqlite
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# MySQL and Redis (optional)
# ------------------------------------------------------------------------------
# To use MySQL and Redis, remove the "#" from these lines and set DB_PASSWORD.
# Remove the four SQLite lines above. COMPOSE_PROFILES=mysql makes
# docker compose start the mysql and redis services. Without Docker, set
# DB_HOST and REDIS_HOST to your servers (docker compose sets them).
# COMPOSE_PROFILES=mysql
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=feedbackpilgrim
# DB_USERNAME=feedbackpilgrim
# DB_PASSWORD=
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------------
# SMTP is the default mailer. Set MAIL_MAILER=mailgun and the MAILGUN_* values
# to use Mailgun, or MAIL_MAILER=ses and the AWS_* values to use Amazon SES.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The SMTP connection uses TLS with STARTTLS when the server offers it. Port
# 465 uses implicit TLS ("smtps"). To force a scheme, set MAIL_SCHEME to smtp
# or smtps.
# MAIL_SCHEME=
MAIL_FROM_ADDRESS="feedback@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SES keys. If a key is empty, the app uses the AWS_* value above.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
AWS_SES_CONFIGURATION_SET=

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Docker Compose
# ------------------------------------------------------------------------------
# docker-compose.yml and docker-compose.image.yml read these values. The
# defaults are in the comments.
# The host address and the host port of the web service. Keep 127.0.0.1 when
# the reverse proxy is on the same host.
# APP_BIND=127.0.0.1
# APP_PORT=8080
# Only for docker-compose.image.yml: the image and the tag to run.
# FEEDBACKPILGRIM_IMAGE=ghcr.io/amedina068/feedbackpilgrim
# FEEDBACKPILGRIM_VERSION=latest

# ------------------------------------------------------------------------------
# Local development
# ------------------------------------------------------------------------------
# For "php artisan serve", set these values. The public site of a project is
# then at http://<slug>.localhost:8000.
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://localhost:8000
